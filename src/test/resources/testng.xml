<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Java Selenium TestNG Suite" parallel="methods" thread-count="2" verbose="1">
    <listeners>
        <listener class-name="com.tests.listeners.TestListener"/>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>
    <test name="Smoke and Regression">
        <classes>
            <class name="com.tests.smoke.LoginTest"/>
<!--            <class name="com.tests.smoke.SearchTest"/>-->
<!--            <class name="com.tests.regression.CheckoutTest"/>-->
<!--            <class name="com.tests.regression.PaymentTest"/>-->
            <class name="com.tests.api.ApiHealthTest"/>
        </classes>
    </test>
</suite>
